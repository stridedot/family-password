# 家庭密码后端环境配置模板：复制为 .env 后按需修改（.env 不入库）

# HTTP 监听端口
PORT=8080

# PostgreSQL / Neon（本地可 Docker 起 Postgres，或注册 Neon/Supabase 免费库）
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# cron 表达式（含秒，6 段）：0 0 * * * * = 每小时推进一次状态机
CRON_SPEC='0 0 * * * *'

# Gin 运行模式：debug / release
GIN_MODE=debug

# CORS 允许来源：* = 任意来源（本地开发）；生产填前端域名，如 https://family-password.vercel.app
ALLOW_ORIGIN=*

# 静默阈值（天）：主人连续未心跳多久后触发释放（确认周期）
SILENCE_DAYS=30

# 反悔窗口（小时）：进入宽限期后留给主人取消的时间（默认 14 天 = 336h）
GRACE_HOURS=336

# 邮件预警（可选）：不填 SMTP 则仅控制台打印，方便本地跑通整条链路
# 后端对外地址，用于邮件里的"确认存活"链接（如 https://your-backend.railway.app）；留空默认 http://localhost:Port
BASE_URL=
# 前端应用对外地址，用于邮件里给受益人的"取用链接"（如 https://your-vault.vercel.app）。
# 必须填：后端没有 / 路由也不托管静态页，留空则无法给受益人发送取用通知（会跳过并告警）
APP_URL=
# 提前多少天开始发预警邮件：静默阈值剩这么多天(Day 23) 与 宽限期剩这么多天(Day 37) 各催一次
REMINDER_DAYS=7
# 发件人
MAIL_FROM=
MAIL_FROM_NAME=家庭密码
# —— 邮件发送（SMTP / Resend）——
# 使用 Resend 时填写以下值（推荐；自定义域名送达率高，死亡开关提醒邮件不能进垃圾箱）：
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxxxxxx   （Resend 后台的 API Key，非你的账户密码）
#   MAIL_FROM=noreply@你的域名   （必须是 Resend 已验证发送域名下的邮箱）
# 不填则后端仅控制台打印邮件内容，不发真邮件（便于本地跑通，不污染真实邮箱）。
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
