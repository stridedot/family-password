# 家庭密码后端环境配置模板：复制为 .env 后按需修改（.env 不入库）

# HTTP 监听端口
PORT=8080

# PostgreSQL / Neon（本地可 Docker 起 Postgres，或注册 Neon/Supabase 免费库）
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# cron 表达式（含秒，6 段）：0 0 * * * * = 每小时推进一次状态机
CRON_SPEC=0 0 * * * *

# Gin 运行模式：debug / release
GIN_MODE=debug

# 静默阈值（天）：主人连续未心跳多久后触发释放（确认周期）
SILENCE_DAYS=30

# 反悔窗口（小时）：进入宽限期后留给主人取消的时间（默认 14 天 = 336h）
GRACE_HOURS=336

# 邮件预警（可选）：不填 SMTP 则仅控制台打印，方便本地跑通整条链路
# 后端对外地址，用于邮件里的"确认存活"链接（如 https://your-backend.railway.app）；留空默认 http://localhost:Port
BASE_URL=
# 前端应用对外地址，用于邮件里给受益人的"取用链接"（如 https://your-vault.vercel.app）；留空同 BASE_URL
APP_URL=
# 提前多少天开始发预警邮件：静默阈值剩这么多天(Day 23) 与 宽限期剩这么多天(Day 37) 各催一次
REMINDER_DAYS=7
# 发件人
MAIL_FROM=
MAIL_FROM_NAME=家庭密码
# SMTP 服务器（配齐才发真邮件；缺任一回退控制台打印）
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
